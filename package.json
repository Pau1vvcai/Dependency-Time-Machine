{
  "name": "dependency-time-machine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "docker compose up -d postgres && pnpm --filter web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "runner:build": "docker build -f docker/runner.Dockerfile -t dtm-runner:local .",
    "worker:baseline": "pnpm --filter @dependency-time-machine/orchestrator worker:baseline",
    "build": "pnpm --filter web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test"
  }
}

